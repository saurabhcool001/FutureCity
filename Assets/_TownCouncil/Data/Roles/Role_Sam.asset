  hiddenGoal: Protect the library.
  secret: Your family lives on Riverside Street, a 'high-risk' postcode.
  roomEnvironmentPrefab: {fileID: 0}
  roomIntro: Your bedroom on Riverside Street. Revision notes cover the desk.
  valuePriorities:
  - meter: {fileID: 11400000, guid: d5c3010366a72564fa02ae51da0d02e2, type: 2}
